# Murf API (required for voice generation)
MURF_AI_API_KEY=your_murf_api_key

# Google Gemini (required) — powers ALL text + audio AI:
# story enhancement, dual-voice dialogue, emotion, Memory DNA, translation,
# and voice-note transcription. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# Optional — override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional — absolute base URL for share/OG links when deployed
NEXT_PUBLIC_APP_URL=https://your-deployment.example.com
