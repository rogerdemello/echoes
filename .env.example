# Murf API (required for voice generation)
MURF_AI_API_KEY=your_murf_api_key

# Azure OpenAI (required for story enhancement, translation, emotion, Memory DNA)
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_WHISPER_DEPLOYMENT_NAME=whisper

# Optional — absolute base URL for share/OG links when deployed
NEXT_PUBLIC_APP_URL=https://your-deployment.example.com
